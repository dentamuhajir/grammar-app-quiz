{
  "name": "grammar-app-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-pwa.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node tests/run.mjs",
    "article:prompt": "node scripts/add-article.mjs --prompt",
    "article:import": "node scripts/add-article.mjs --import",
    "article:validate": "node scripts/add-article.mjs --validate"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
